BOT_TOKEN=your-telegram-bot-token
ADMIN_IDS=123456789,987654321
DATABASE_PATH=data/bot.db
WEB_APP_URL=https://your-public-miniapp-url.example.com
MINIAPP_ALLOW_TG_ID_FALLBACK=0
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
ADMIN_WEB_PASSWORD=change-this-password
# Guard role: password-only web login that can ONLY access the check-in endpoints.
# Leave empty to disable guard login (POST /api/guard/login then returns 503).
GUARD_WEB_PASSWORD=change-this-guard-password

# --- Production security (budapesttunderi.com) ---
# When REQUIRE_SECURE_CONFIG=1 (or ENVIRONMENT=production) the server refuses to
# start unless the signing secrets below are set (or BOT_TOKEN is present to back
# them) AND MINIAPP_ALLOW_TG_ID_FALLBACK is OFF. Leave unset in dev/CI.
REQUIRE_SECURE_CONFIG=0
ENVIRONMENT=
# Dedicated signing secrets (long random strings). Required in production so signed
# upload links, ticket QR signatures, and email codes cannot be forged.
UPLOAD_LINK_SECRET=change-this-long-random-secret
TICKET_QR_SECRET=change-this-long-random-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=Budapest Tunderi <noreply@budapesttunderi.com>
EMAIL_LOGIN_SECRET=change-this-long-random-secret
EMAIL_LOGIN_TTL_SECONDS=600
EMAIL_LOGIN_RATE_LIMIT=8
EMAIL_CODE_ATTEMPT_LIMIT=5
EMAIL_LOGIN_DEV_MODE=0
LEGACY_WEB_REGISTER_ENABLED=0
SESSION_COOKIE_MAX_AGE_SECONDS=7776000
GOOGLE_CLIENT_ID=
# Telegram Login Widget bot username (without @). When set, a Telegram sign-in
# button appears next to Google in the website Register step. Leave empty to disable.
TELEGRAM_LOGIN_BOT_USERNAME=
# Ticket change policy (website "My tickets"): a customer with an approved ticket
# for a future event can request to MOVE it up to this many hours before the event,
# or request a REFUND up to this many hours before. These are requests only; the
# reservation stays approved and admins are notified.
TICKET_MOVE_MIN_HOURS=24
TICKET_REFUND_MIN_HOURS=72
